# Public Supabase project URL and anon key. Never put service-role keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets used by the daily retention job.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional read-only Pakomak connector. Keep false until reuse terms are confirmed.
PAKOMAK_CONNECTOR_ENABLED=false
PAKOMAK_ARCGIS_QUERY_URL=https://maps.pakomak.mk/arcgis/rest/services/PAKOMAK/garbage_containers_dashboard/MapServer/1/query

# Optional OSM-compatible tile endpoint. Keep attribution visible if changing providers.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
